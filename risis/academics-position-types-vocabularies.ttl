@prefix agent: <https://w3id.org/fossr/data/agent/> .
@prefix ac: <https://w3id.org/fossr/onto/academic-career/> .
@prefix vocab: <https://w3id.org/fossr/vocab/> .
@prefix ptype-it: <https://w3id.org/fossr/vocab/it-university-position-types/> .
@prefix ptype-epr: <https://w3id.org/fossr/vocab/it-epr-position-types/> .
@prefix grade-it: <https://w3id.org/fossr/vocab/it-equivalent-grades/> .
@prefix emptype: <https://w3id.org/fossr/vocab/employment-types/> .
@prefix regime: <https://w3id.org/fossr/vocab/working-time-regimes/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/fossr/vocab/academics> a owl:Ontology ;
    rdfs:label "FOSSR controlled vocabularies: academic careers"@en ;
    dc:description "SKOS vocabularies used by the FOSSR academic-career module: position types (qualifiche) of Italian universities (vocab:it-university-position-types) and of Italian public research organizations (vocab:it-epr-position-types, with the levels I-VIII as collections), the equivalence between university tiers and research organization levels (collections grade-it:fascia-1, -2, -3), employment types (vocab:employment-types, provisional) and working-time regimes (vocab:working-time-regimes). Hierarchies use skos:broader, with skos:narrower materialised as its inverse; successions between position types use dct:isReplacedBy / dct:replaces. The research organization concepts do not yet carry the source strings of the CNR staff directory as skos:hiddenLabel. Provenance convention: each concept scheme (the classification) has as dct:creator the agent that conceived it (e.g. the MUR, through its decrees) and as dct:source the document it comes from; this file (its formalization in SKOS) has as dct:creator its author and as dct:publisher FOSSR and ISTC-CNR. Agents are described in https://w3id.org/fossr/data/agents."@en ;
    dct:creator <https://orcid.org/0000-0001-6577-5606> ;
    dct:publisher agent:fossr , agent:istc-cnr ;
    owl:versionInfo "0.2 (2026-11-20)" .


#################################################################
#    Italian universities
#################################################################

vocab:it-university-position-types a skos:ConceptScheme ;
    skos:prefLabel "Qualifiche universitarie (Italia)"@it , "Italian university position types"@en ;
    dct:creator agent:mur ;
    dct:contributor <https://orcid.org/0000-0001-6577-5606> ;
    dct:source <https://cercauniversita.mur.gov.it> ;
    dc:description "Position types (qualifiche) of professors and researchers of Italian universities, including figures that can no longer be appointed (kept for historical data). Concepts follow the values of the \"Ruolo\" filter of the MUR Cercauniversità service; employment type (fixed-term / permanent) and working-time regime (tempo pieno / tempo definito) are not part of the concepts: they are recorded on the position (ac:hasEmploymentType, ac:hasRegimePeriod). The Cercauniversità strings that combine the position type with the regime are kept as skos:hiddenLabel of the corresponding concept."@en ;
    skos:hasTopConcept ptype-it:professore , ptype-it:ricercatore .

ptype-it:professore a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-university-position-types ;
    skos:topConceptOf vocab:it-university-position-types ;
    skos:prefLabel "Professore"@it , "Professor"@en ;
    skos:definition "University professor: first-tier (prima fascia) or second-tier (seconda fascia) professor, or a historical figure assimilated to them."@en ;
    skos:narrower ptype-it:professore-prima-fascia , ptype-it:professore-seconda-fascia , ptype-it:incaricato .

ptype-it:professore-prima-fascia a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-university-position-types ;
    skos:prefLabel "Professore di prima fascia"@it , "Full professor (first tier)"@en ;
    skos:definition "First-tier professor (professore di prima fascia): ordinario, and the historical straordinario."@en ;
    skos:broader ptype-it:professore ;
    skos:narrower ptype-it:ordinario , ptype-it:ordinario-re , ptype-it:straordinario , ptype-it:straordinario-td .

ptype-it:ordinario a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-university-position-types ;
    skos:prefLabel "Professore ordinario"@it , "Full professor"@en ;
    skos:hiddenLabel "Ordinario"@it ;
    skos:broader ptype-it:professore-prima-fascia .

ptype-it:ordinario-re a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-university-position-types ;
    skos:prefLabel "Ordinario r.e."@it ;
    skos:hiddenLabel "Ordinario r.e."@it ;
    skos:editorialNote "Label taken from the Cercauniversità \"Ruolo\" filter; the meaning of \"r.e.\" is to be documented."@en ;
    skos:broader ptype-it:professore-prima-fascia .

ptype-it:straordinario a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-university-position-types ;
    skos:prefLabel "Professore straordinario"@it , "Full professor (pre-confirmation)"@en ;
    skos:hiddenLabel "Straordinario"@it ;
    skos:historyNote "First-tier professor in the period before confirmation as ordinario, under the rules in force before L. 240/2010."@en ;
    skos:broader ptype-it:professore-prima-fascia .

ptype-it:straordinario-td a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-university-position-types ;
    skos:prefLabel "Professore straordinario a tempo determinato"@it , "Fixed-term full professor"@en ;
    skos:hiddenLabel "Straordinario tempo determinato"@it ;
    skos:broader ptype-it:professore-prima-fascia .

ptype-it:professore-seconda-fascia a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-university-position-types ;
    skos:prefLabel "Professore di seconda fascia"@it , "Associate professor (second tier)"@en ;
    skos:definition "Second-tier professor (professore di seconda fascia): professore associato."@en ;
    skos:broader ptype-it:professore ;
    skos:narrower ptype-it:associato , ptype-it:associato-confermato , ptype-it:associato-non-confermato , ptype-it:associato-re .

ptype-it:associato a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-university-position-types ;
    skos:prefLabel "Professore associato"@it , "Associate professor"@en ;
    skos:hiddenLabel "Associato"@it ;
    skos:broader ptype-it:professore-seconda-fascia .

ptype-it:associato-confermato a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-university-position-types ;
    skos:prefLabel "Professore associato confermato"@it , "Associate professor (confirmed)"@en ;
    skos:hiddenLabel "Associato confermato"@it ;
    skos:scopeNote "Confirmation (conferma) does not start a new position: the change from non confermato to confermato is a change within the same position."@en ;
    skos:broader ptype-it:professore-seconda-fascia .

ptype-it:associato-non-confermato a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-university-position-types ;
    skos:prefLabel "Professore associato non confermato"@it , "Associate professor (not yet confirmed)"@en ;
    skos:hiddenLabel "Associato non confermato"@it ;
    skos:broader ptype-it:professore-seconda-fascia .

ptype-it:associato-re a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-university-position-types ;
    skos:prefLabel "Associato r.e."@it ;
    skos:hiddenLabel "Associato r.e."@it ;
    skos:editorialNote "Label taken from the Cercauniversità \"Ruolo\" filter; the meaning of \"r.e.\" is to be documented."@en ;
    skos:broader ptype-it:professore-seconda-fascia .

ptype-it:incaricato a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-university-position-types ;
    skos:prefLabel "Professore incaricato"@it , "Appointed lecturer (incaricato)"@en ;
    skos:hiddenLabel "Incaricato"@it ;
    skos:historyNote "Historical figure: professore incaricato stabilizzato (L. 766/1973), no longer appointed."@en ;
    skos:broader ptype-it:professore .

ptype-it:ricercatore a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-university-position-types ;
    skos:topConceptOf vocab:it-university-position-types ;
    skos:prefLabel "Ricercatore universitario"@it , "University researcher"@en ;
    skos:definition "University researcher: permanent (ruolo a esaurimento) or fixed-term researcher, the historical assistente, and the pre-tenure research positions (pre-ruolo)."@en ;
    skos:narrower ptype-it:ricercatore-tempo-indeterminato , ptype-it:ricercatore-non-confermato , ptype-it:assistente-re , ptype-it:rtd-l230-05 , ptype-it:rtda , ptype-it:rtdb , ptype-it:rtt , ptype-it:pre-ruolo .

ptype-it:ricercatore-tempo-indeterminato a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-university-position-types ;
    skos:prefLabel "Ricercatore a tempo indeterminato"@it , "Permanent researcher"@en ;
    skos:hiddenLabel "Ricercatore"@it ;
    skos:definition "University researcher of the permanent role (ruolo dei ricercatori universitari), confirmed."@en ;
    skos:historyNote "No new appointments after L. 240/2010: the role is being phased out (ruolo a esaurimento)."@en ;
    skos:broader ptype-it:ricercatore .

ptype-it:ricercatore-non-confermato a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-university-position-types ;
    skos:prefLabel "Ricercatore non confermato"@it , "Permanent researcher (not yet confirmed)"@en ;
    skos:hiddenLabel "Ricercatore non confermato"@it ;
    skos:broader ptype-it:ricercatore .

ptype-it:assistente-re a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-university-position-types ;
    skos:prefLabel "Assistente del ruolo a esaurimento"@it , "Assistant (role being phased out)"@en ;
    skos:hiddenLabel "Assistente ruolo esaurimento"@it ;
    skos:historyNote "Historical figure of the assistenti universitari, placed in a role being phased out by D.P.R. 382/1980."@en ;
    skos:broader ptype-it:ricercatore .

ptype-it:rtd-l230-05 a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-university-position-types ;
    skos:prefLabel "Ricercatore a tempo determinato (L. 230/2005)"@it , "Fixed-term researcher (L. 230/2005)"@en ;
    skos:hiddenLabel "Ricercatore a t.d. (art.1 comma 14 L. 230/05)"@it ;
    skos:definition "Fixed-term researcher under art. 1, c. 14, L. 230/2005."@en ;
    skos:broader ptype-it:ricercatore .

ptype-it:rtda a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-university-position-types ;
    skos:prefLabel "Ricercatore a tempo determinato di tipo A"@it , "Fixed-term researcher, type A (RTDa)"@en ;
    skos:altLabel "RTDa"@it ;
    skos:hiddenLabel "Ricercatore a t.d. - t.pieno (art. 24 c.3-a L. 240/10)"@it , "Ricercatore a t.d. - t.defin. (art. 24 c.3-a L. 240/10)"@it ;
    skos:definition "Fixed-term researcher under art. 24, c. 3, lett. a), L. 240/2010 (previous wording)."@en ;
    skos:historyNote "Replaced by the tenure-track researcher (RTT) introduced by D.L. 36/2022, converted by L. 79/2022."@en ;
    skos:broader ptype-it:ricercatore ;
    dct:isReplacedBy ptype-it:rtt .

ptype-it:rtdb a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-university-position-types ;
    skos:prefLabel "Ricercatore a tempo determinato di tipo B"@it , "Fixed-term researcher, type B (RTDb)"@en ;
    skos:altLabel "RTDb"@it ;
    skos:hiddenLabel "Ricercatore a t.d. - t.pieno (art. 24 c.3-b L. 240/10)"@it , "Ricercatore a t.d. - t.defin. (art. 24 c.3-b L. 240/10)"@it ;
    skos:definition "Fixed-term researcher under art. 24, c. 3, lett. b), L. 240/2010 (previous wording)."@en ;
    skos:historyNote "Replaced by the tenure-track researcher (RTT) introduced by D.L. 36/2022, converted by L. 79/2022."@en ;
    skos:broader ptype-it:ricercatore ;
    dct:isReplacedBy ptype-it:rtt .

ptype-it:rtt a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-university-position-types ;
    skos:prefLabel "Ricercatore in tenure track"@it , "Tenure-track researcher (RTT)"@en ;
    skos:altLabel "RTT"@it ;
    skos:hiddenLabel "Ricercatore a t.d. - t.pieno (L. 79/2022)"@it , "Ricercatore a t.d. - t.defin. (L. 79/2022)"@it ;
    skos:definition "Fixed-term tenure-track researcher under art. 24 L. 240/2010 as amended by D.L. 36/2022, converted by L. 79/2022 (six-year contract leading to the role of associate professor)."@en ;
    skos:broader ptype-it:ricercatore ;
    dct:replaces ptype-it:rtda , ptype-it:rtdb .

ptype-it:pre-ruolo a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-university-position-types ;
    skos:prefLabel "Pre-ruolo"@it , "Pre-tenure research position"@en ;
    skos:definition "Research positions before the researcher career (pre-ruolo): research contracts, research grants and post-doc or research appointments."@en ;
    skos:broader ptype-it:ricercatore ;
    skos:narrower ptype-it:assegno-ricerca , ptype-it:contratto-ricerca , ptype-it:incarico-post-doc , ptype-it:incarico-ricerca .

ptype-it:assegno-ricerca a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-university-position-types ;
    skos:prefLabel "Assegno di ricerca"@it , "Research grant (assegno di ricerca)"@en ;
    skos:definition "Research grant under art. 22 L. 240/2010 (previous wording)."@en ;
    skos:historyNote "Replaced by the research contract (contratto di ricerca) by D.L. 36/2022, converted by L. 79/2022."@en ;
    skos:broader ptype-it:pre-ruolo ;
    dct:isReplacedBy ptype-it:contratto-ricerca .

ptype-it:contratto-ricerca a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-university-position-types ;
    skos:prefLabel "Contratto di ricerca"@it , "Research contract"@en ;
    skos:definition "Fixed-term employment contract for a specific research project, under art. 22 L. 240/2010 as amended by D.L. 36/2022, converted by L. 79/2022."@en ;
    skos:broader ptype-it:pre-ruolo ;
    dct:replaces ptype-it:assegno-ricerca .

ptype-it:incarico-post-doc a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-university-position-types ;
    skos:prefLabel "Incarico post-doc"@it , "Post-doc appointment"@en ;
    skos:definition "Post-doc appointment under art. 22-bis L. 240/2010, introduced by D.L. 45/2025, converted by L. 79/2025."@en ;
    skos:broader ptype-it:pre-ruolo .

ptype-it:incarico-ricerca a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-university-position-types ;
    skos:prefLabel "Incarico di ricerca"@it , "Research appointment"@en ;
    skos:definition "Research appointment under art. 22-ter L. 240/2010, introduced by D.L. 45/2025, converted by L. 79/2025."@en ;
    skos:broader ptype-it:pre-ruolo .

#################################################################
#    Italian public research organizations
#################################################################

vocab:it-epr-position-types a skos:ConceptScheme ;
    skos:prefLabel "Qualifiche degli enti pubblici di ricerca (Italia)"@it , "Italian public research organization position types"@en ;
    dct:creator agent:mur ;
    dct:contributor <https://orcid.org/0000-0001-6577-5606> ;
    dc:description "Position types (qualifiche) of the staff of Italian public research organizations (enti pubblici di ricerca, EPR) covered by the national collective agreement (CCNL Istruzione e Ricerca), in the arrangement of D.P.R. 171/1991 and of the CCNL in force. The hierarchy is by area and professional profile (skos:broader: a primo ricercatore is a kind of ricercatore); the leaves are the profile at a given level. Levels (I-VIII) are a separate dimension, given by the skos:Collection ptype-epr:livello-i ... ptype-epr:livello-viii. Employment type and working-time regime are recorded on the position."@en ;
    skos:hasTopConcept ptype-epr:personale-ricerca-tecnologia , ptype-epr:personale-tecnico-amministrativo , ptype-epr:dirigente-amministrativo .

ptype-epr:personale-ricerca-tecnologia a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:topConceptOf vocab:it-epr-position-types ;
    skos:prefLabel "Personale ricercatore e tecnologo"@it , "Researchers and technologists"@en ;
    skos:definition "Staff with the professional profiles of ricercatore and tecnologo, on levels I to III."@en ;
    skos:narrower ptype-epr:ricercatore , ptype-epr:tecnologo .

ptype-epr:ricercatore a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Ricercatore (profilo)"@it , "Researcher (profile)"@en ;
    skos:definition "Professional profile of ricercatore, articulated on three levels: dirigente di ricerca (I), primo ricercatore (II), ricercatore (III)."@en ;
    skos:broader ptype-epr:personale-ricerca-tecnologia ;
    skos:narrower ptype-epr:dirigente-ricerca , ptype-epr:primo-ricercatore , ptype-epr:ricercatore-iii .

ptype-epr:dirigente-ricerca a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Dirigente di ricerca"@it , "Research director"@en ;
    skos:broader ptype-epr:ricercatore .

ptype-epr:primo-ricercatore a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Primo ricercatore"@it , "Senior researcher"@en ;
    skos:broader ptype-epr:ricercatore .

ptype-epr:ricercatore-iii a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Ricercatore III livello"@it , "Researcher (level III)"@en ;
    skos:broader ptype-epr:ricercatore .

ptype-epr:tecnologo a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Tecnologo (profilo)"@it , "Technologist (profile)"@en ;
    skos:definition "Professional profile of tecnologo, articulated on three levels: dirigente tecnologo (I), primo tecnologo (II), tecnologo (III)."@en ;
    skos:broader ptype-epr:personale-ricerca-tecnologia ;
    skos:narrower ptype-epr:dirigente-tecnologo , ptype-epr:primo-tecnologo , ptype-epr:tecnologo-iii .

ptype-epr:dirigente-tecnologo a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Dirigente tecnologo"@it , "Technologist director"@en ;
    skos:broader ptype-epr:tecnologo .

ptype-epr:primo-tecnologo a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Primo tecnologo"@it , "Senior technologist"@en ;
    skos:broader ptype-epr:tecnologo .

ptype-epr:tecnologo-iii a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Tecnologo III livello"@it , "Technologist (level III)"@en ;
    skos:broader ptype-epr:tecnologo .

ptype-epr:personale-tecnico-amministrativo a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:topConceptOf vocab:it-epr-position-types ;
    skos:prefLabel "Personale tecnico-amministrativo"@it , "Technical and administrative staff"@en ;
    skos:definition "Technical and administrative staff, on levels IV to VIII."@en ;
    skos:narrower ptype-epr:cter , ptype-epr:funzionario-amministrazione , ptype-epr:collaboratore-amministrazione , ptype-epr:operatore-tecnico , ptype-epr:operatore-amministrazione .

ptype-epr:cter a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Collaboratore tecnico enti di ricerca (profilo)"@it , "Technical collaborator (profile)"@en ;
    skos:altLabel "CTER"@it ;
    skos:definition "Professional profile of collaboratore tecnico enti di ricerca, on levels IV, V, VI."@en ;
    skos:broader ptype-epr:personale-tecnico-amministrativo ;
    skos:narrower ptype-epr:cter-iv , ptype-epr:cter-v , ptype-epr:cter-vi .

ptype-epr:cter-iv a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Collaboratore tecnico enti di ricerca IV livello"@it , "Technical collaborator (level IV)"@en ;
    skos:altLabel "CTER IV livello"@it ;
    skos:broader ptype-epr:cter .

ptype-epr:cter-v a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Collaboratore tecnico enti di ricerca V livello"@it , "Technical collaborator (level V)"@en ;
    skos:altLabel "CTER V livello"@it ;
    skos:broader ptype-epr:cter .

ptype-epr:cter-vi a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Collaboratore tecnico enti di ricerca VI livello"@it , "Technical collaborator (level VI)"@en ;
    skos:altLabel "CTER VI livello"@it ;
    skos:broader ptype-epr:cter .

ptype-epr:funzionario-amministrazione a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Funzionario di amministrazione (profilo)"@it , "Administrative officer (profile)"@en ;
    skos:definition "Professional profile of funzionario di amministrazione, on levels IV, V."@en ;
    skos:broader ptype-epr:personale-tecnico-amministrativo ;
    skos:narrower ptype-epr:funzionario-amministrazione-iv , ptype-epr:funzionario-amministrazione-v .

ptype-epr:funzionario-amministrazione-iv a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Funzionario di amministrazione IV livello"@it , "Administrative officer (level IV)"@en ;
    skos:broader ptype-epr:funzionario-amministrazione .

ptype-epr:funzionario-amministrazione-v a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Funzionario di amministrazione V livello"@it , "Administrative officer (level V)"@en ;
    skos:broader ptype-epr:funzionario-amministrazione .

ptype-epr:collaboratore-amministrazione a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Collaboratore di amministrazione (profilo)"@it , "Administrative collaborator (profile)"@en ;
    skos:definition "Professional profile of collaboratore di amministrazione, on levels V, VI, VII."@en ;
    skos:broader ptype-epr:personale-tecnico-amministrativo ;
    skos:narrower ptype-epr:collaboratore-amministrazione-v , ptype-epr:collaboratore-amministrazione-vi , ptype-epr:collaboratore-amministrazione-vii .

ptype-epr:collaboratore-amministrazione-v a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Collaboratore di amministrazione V livello"@it , "Administrative collaborator (level V)"@en ;
    skos:broader ptype-epr:collaboratore-amministrazione .

ptype-epr:collaboratore-amministrazione-vi a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Collaboratore di amministrazione VI livello"@it , "Administrative collaborator (level VI)"@en ;
    skos:broader ptype-epr:collaboratore-amministrazione .

ptype-epr:collaboratore-amministrazione-vii a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Collaboratore di amministrazione VII livello"@it , "Administrative collaborator (level VII)"@en ;
    skos:broader ptype-epr:collaboratore-amministrazione .

ptype-epr:operatore-tecnico a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Operatore tecnico (profilo)"@it , "Technical operator (profile)"@en ;
    skos:definition "Professional profile of operatore tecnico, on levels VI, VII, VIII."@en ;
    skos:broader ptype-epr:personale-tecnico-amministrativo ;
    skos:narrower ptype-epr:operatore-tecnico-vi , ptype-epr:operatore-tecnico-vii , ptype-epr:operatore-tecnico-viii .

ptype-epr:operatore-tecnico-vi a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Operatore tecnico VI livello"@it , "Technical operator (level VI)"@en ;
    skos:broader ptype-epr:operatore-tecnico .

ptype-epr:operatore-tecnico-vii a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Operatore tecnico VII livello"@it , "Technical operator (level VII)"@en ;
    skos:broader ptype-epr:operatore-tecnico .

ptype-epr:operatore-tecnico-viii a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Operatore tecnico VIII livello"@it , "Technical operator (level VIII)"@en ;
    skos:broader ptype-epr:operatore-tecnico .

ptype-epr:operatore-amministrazione a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Operatore di amministrazione (profilo)"@it , "Administrative operator (profile)"@en ;
    skos:definition "Professional profile of operatore di amministrazione, on levels VII, VIII."@en ;
    skos:broader ptype-epr:personale-tecnico-amministrativo ;
    skos:narrower ptype-epr:operatore-amministrazione-vii , ptype-epr:operatore-amministrazione-viii .

ptype-epr:operatore-amministrazione-vii a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Operatore di amministrazione VII livello"@it , "Administrative operator (level VII)"@en ;
    skos:broader ptype-epr:operatore-amministrazione .

ptype-epr:operatore-amministrazione-viii a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Operatore di amministrazione VIII livello"@it , "Administrative operator (level VIII)"@en ;
    skos:broader ptype-epr:operatore-amministrazione .

ptype-epr:dirigente-amministrativo a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:topConceptOf vocab:it-epr-position-types ;
    skos:prefLabel "Dirigente amministrativo"@it , "Administrative executive"@en ;
    skos:definition "Administrative executive (dirigente amministrativo) of a public research organization, of first or second tier."@en ;
    skos:narrower ptype-epr:dirigente-prima-fascia , ptype-epr:dirigente-seconda-fascia .

ptype-epr:dirigente-prima-fascia a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Dirigente amministrativo di prima fascia"@it , "First-tier administrative executive"@en ;
    skos:notation "D1" ;
    skos:editorialNote "Code D1 as in the CNR staff directory; to be checked against the source table."@en ;
    skos:broader ptype-epr:dirigente-amministrativo .

ptype-epr:dirigente-seconda-fascia a skos:Concept , ac:PositionType ;
    skos:inScheme vocab:it-epr-position-types ;
    skos:prefLabel "Dirigente amministrativo di seconda fascia"@it , "Second-tier administrative executive"@en ;
    skos:notation "D2" ;
    skos:editorialNote "Code D2 as in the CNR staff directory; to be checked against the source table."@en ;
    skos:broader ptype-epr:dirigente-amministrativo .

#################################################################
#    Levels of the public research organizations (collections)
#################################################################

ptype-epr:livello-i a skos:Collection ;
    skos:prefLabel "Livello I"@it , "Level I"@en ;
    skos:notation "I" ;
    skos:definition "Position types of level I (livello professionale) of the public research organizations."@en ;
    skos:member ptype-epr:dirigente-ricerca , ptype-epr:dirigente-tecnologo .

ptype-epr:livello-ii a skos:Collection ;
    skos:prefLabel "Livello II"@it , "Level II"@en ;
    skos:notation "II" ;
    skos:definition "Position types of level II (livello professionale) of the public research organizations."@en ;
    skos:member ptype-epr:primo-ricercatore , ptype-epr:primo-tecnologo .

ptype-epr:livello-iii a skos:Collection ;
    skos:prefLabel "Livello III"@it , "Level III"@en ;
    skos:notation "III" ;
    skos:definition "Position types of level III (livello professionale) of the public research organizations."@en ;
    skos:member ptype-epr:ricercatore-iii , ptype-epr:tecnologo-iii .

ptype-epr:livello-iv a skos:Collection ;
    skos:prefLabel "Livello IV"@it , "Level IV"@en ;
    skos:notation "IV" ;
    skos:definition "Position types of level IV (livello professionale) of the public research organizations."@en ;
    skos:member ptype-epr:cter-iv , ptype-epr:funzionario-amministrazione-iv .

ptype-epr:livello-v a skos:Collection ;
    skos:prefLabel "Livello V"@it , "Level V"@en ;
    skos:notation "V" ;
    skos:definition "Position types of level V (livello professionale) of the public research organizations."@en ;
    skos:member ptype-epr:cter-v , ptype-epr:funzionario-amministrazione-v , ptype-epr:collaboratore-amministrazione-v .

ptype-epr:livello-vi a skos:Collection ;
    skos:prefLabel "Livello VI"@it , "Level VI"@en ;
    skos:notation "VI" ;
    skos:definition "Position types of level VI (livello professionale) of the public research organizations."@en ;
    skos:member ptype-epr:cter-vi , ptype-epr:collaboratore-amministrazione-vi , ptype-epr:operatore-tecnico-vi .

ptype-epr:livello-vii a skos:Collection ;
    skos:prefLabel "Livello VII"@it , "Level VII"@en ;
    skos:notation "VII" ;
    skos:definition "Position types of level VII (livello professionale) of the public research organizations."@en ;
    skos:member ptype-epr:collaboratore-amministrazione-vii , ptype-epr:operatore-tecnico-vii , ptype-epr:operatore-amministrazione-vii .

ptype-epr:livello-viii a skos:Collection ;
    skos:prefLabel "Livello VIII"@it , "Level VIII"@en ;
    skos:notation "VIII" ;
    skos:definition "Position types of level VIII (livello professionale) of the public research organizations."@en ;
    skos:member ptype-epr:operatore-tecnico-viii , ptype-epr:operatore-amministrazione-viii .

#################################################################
#    Equivalent tiers between universities and research organizations (collections)
#################################################################

grade-it:fascia-1 a skos:Collection ;
    dct:creator agent:mur ;
    skos:prefLabel "Prima fascia (posizioni equiparate)"@it , "First tier (equivalent positions)"@en ;
    skos:definition "University and public research organization position types considered equivalent for the mobility between universities and research organizations: first-tier professors and level I researchers and technologists."@en ;
    skos:scopeNote "Members can be groups (concepts with narrower concepts) or collections: to get all the position types, follow skos:member+ and then skos:narrower*."@en ;
    dct:source <https://www.mur.gov.it/sites/default/files/2022-06/DM%20n.%20367%20del%2029-04-2022.pdf> ;
    skos:member ptype-it:professore-prima-fascia , ptype-epr:livello-i .

grade-it:fascia-2 a skos:Collection ;
    dct:creator agent:mur ;
    skos:prefLabel "Seconda fascia (posizioni equiparate)"@it , "Second tier (equivalent positions)"@en ;
    skos:definition "University and public research organization position types considered equivalent for the mobility between universities and research organizations: second-tier professors and level II researchers and technologists."@en ;
    skos:scopeNote "Members can be groups (concepts with narrower concepts) or collections: to get all the position types, follow skos:member+ and then skos:narrower*."@en ;
    dct:source <https://www.mur.gov.it/sites/default/files/2022-06/DM%20n.%20367%20del%2029-04-2022.pdf> ;
    skos:member ptype-it:professore-seconda-fascia , ptype-epr:livello-ii .

grade-it:fascia-3 a skos:Collection ;
    dct:creator agent:mur ;
    skos:prefLabel "Terza fascia (posizioni equiparate)"@it , "Third tier (equivalent positions)"@en ;
    skos:definition "University researchers (permanent and fixed-term) and level III researchers and technologists of the public research organizations."@en ;
    skos:scopeNote "Conventional equivalence, used in practice (e.g. 'qualifica pari o superiore al III livello/fascia' in calls), not established by a norm. Pre-tenure positions (pre-ruolo) and the historical assistente are not included."@en ;
    skos:member ptype-it:ricercatore-tempo-indeterminato , ptype-it:ricercatore-non-confermato , ptype-it:rtd-l230-05 , ptype-it:rtda , ptype-it:rtdb , ptype-it:rtt , ptype-epr:livello-iii .

#################################################################
#    Employment types (provisional)
#################################################################

vocab:employment-types a skos:ConceptScheme ;
    skos:prefLabel "Tipi di rapporto"@it , "Employment types"@en ;
    dct:creator <https://orcid.org/0000-0001-6577-5606> ;
    dc:description "Types of the relationship between a scholar and the institution of a position, by nature (employment or not) and duration. PROVISIONAL: to be checked against the values of the sources (e.g. the \"rapporto\" field of the CNR staff directory)."@en ;
    skos:hasTopConcept emptype:employment , emptype:non-employment .

emptype:employment a skos:Concept , ac:EmploymentType ;
    skos:inScheme vocab:employment-types ;
    skos:topConceptOf vocab:employment-types ;
    skos:prefLabel "Rapporto di lavoro subordinato"@it , "Employment"@en ;
    skos:definition "Subordinate service relationship with the institution: employment contract, or public-law service relationship of tenured professors and researchers."@en ;
    skos:narrower emptype:permanent , emptype:fixed-term .

emptype:permanent a skos:Concept , ac:EmploymentType ;
    skos:inScheme vocab:employment-types ;
    skos:prefLabel "Tempo indeterminato"@it , "Permanent"@en ;
    skos:altLabel "Di ruolo"@it ;
    skos:broader emptype:employment .

emptype:fixed-term a skos:Concept , ac:EmploymentType ;
    skos:inScheme vocab:employment-types ;
    skos:prefLabel "Tempo determinato"@it , "Fixed-term"@en ;
    skos:broader emptype:employment .

emptype:non-employment a skos:Concept , ac:EmploymentType ;
    skos:inScheme vocab:employment-types ;
    skos:topConceptOf vocab:employment-types ;
    skos:prefLabel "Rapporto non subordinato"@it , "Non-employment relationship"@en ;
    skos:definition "Relationship with the institution that is not subordinate employment."@en ;
    skos:narrower emptype:research-grant , emptype:collaboration .

emptype:research-grant a skos:Concept , ac:EmploymentType ;
    skos:inScheme vocab:employment-types ;
    skos:prefLabel "Assegno o borsa di ricerca"@it , "Research grant or fellowship"@en ;
    skos:broader emptype:non-employment .

emptype:collaboration a skos:Concept , ac:EmploymentType ;
    skos:inScheme vocab:employment-types ;
    skos:prefLabel "Collaborazione o incarico autonomo"@it , "Self-employed collaboration"@en ;
    skos:definition "Self-employed collaboration or professional appointment (e.g. co.co.co., incarico professionale)."@en ;
    skos:broader emptype:non-employment .

#################################################################
#    Working-time regimes
#################################################################

vocab:working-time-regimes a skos:ConceptScheme ;
    skos:prefLabel "Regimi di impegno"@it , "Working-time regimes"@en ;
    dct:creator agent:mur ;
    dc:description "Working-time commitment of a position (regime di impegno), recorded on regime periods of the position (ac:hasRegimePeriod, ac:hasRegime)."@en ;
    skos:hasTopConcept regime:full-time , regime:definite-time , regime:part-time .

regime:full-time a skos:Concept , ac:Regime ;
    skos:inScheme vocab:working-time-regimes ;
    skos:topConceptOf vocab:working-time-regimes ;
    skos:prefLabel "Tempo pieno"@it , "Full time"@en .

regime:definite-time a skos:Concept , ac:Regime ;
    skos:inScheme vocab:working-time-regimes ;
    skos:topConceptOf vocab:working-time-regimes ;
    skos:prefLabel "Tempo definito"@it , "Definite time"@en ;
    skos:definition "Reduced commitment regime of university professors and researchers (tempo definito); it also exists for the staff of public research organizations."@en .

regime:part-time a skos:Concept , ac:Regime ;
    skos:inScheme vocab:working-time-regimes ;
    skos:topConceptOf vocab:working-time-regimes ;
    skos:prefLabel "Tempo parziale"@it , "Part time"@en ;
    skos:definition "Part-time employment (tempo parziale), with a percentage of the full time."@en .
