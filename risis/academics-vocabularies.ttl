@prefix agent: <https://w3id.org/fossr/data/agent/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ac: <https://w3id.org/fossr/onto/academic-career/> .
@prefix vocab: <https://w3id.org/fossr/vocab/> .
@prefix orgtype: <https://w3id.org/fossr/vocab/organization-types/> .
@prefix uni-type-it: <https://w3id.org/fossr/vocab/it-university-types/> .
@prefix vivo: <http://vivoweb.org/ontology/core#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/fossr/vocab/academics-organizations> a owl:Ontology ;
    rdfs:label "FOSSR controlled vocabularies: organizations"@en ;
    dc:description "SKOS vocabularies of the FOSSR academic-career module for organizations: the FOSSR organization types (vocab:organization-types: organizations such as universities, research organizations, companies, and their units such as departments and institutes) and the Italian university types of the MUR Cercauniversità service (vocab:it-university-types), mapped to orgtype:university with skos:broadMatch. Organizations are linked to these concepts with ac:hasOrganizationType (subproperty of org:classification). Mappings to VIVO classes use skos:closeMatch; ROR organization types, which have no IRIs, are given in skos:note. Provenance convention: each concept scheme (the classification) has as dct:creator the agent that conceived it (e.g. the MUR, through its decrees) and as dct:source the document it comes from; this file (its formalization in SKOS) has as dct:creator its author and as dct:publisher FOSSR and ISTC-CNR. Agents are described in https://w3id.org/fossr/data/agents."@en ;
    dct:creator <https://orcid.org/0000-0001-6577-5606> ;
    dct:publisher agent:fossr , agent:istc-cnr ;
    owl:versionInfo "0.4 (2026-11-20)" .


#################################################################
#    Organization types (FOSSR)
#################################################################

vocab:organization-types a skos:ConceptScheme ;
    skos:prefLabel "Tipi di organizzazione"@it , "Organization types"@en ;
    dct:creator <https://orcid.org/0000-0001-6577-5606> ;
    dc:description "Types of organizations (e.g. university, research organization, company) and of their units (e.g. department, institute, laboratory), used with ac:hasOrganizationType (subproperty of org:classification). Organizations are usually org:FormalOrganization, units org:OrganizationalUnit."@en ;
    skos:hasTopConcept orgtype:university ,
        orgtype:researchOrganization ,
        orgtype:company ,
        orgtype:foundation ,
        orgtype:consortium ,
        orgtype:association ,
        orgtype:school ,
        orgtype:department ,
        orgtype:institute ,
        orgtype:interdepartmentalCentre ,
        orgtype:researchGroup ,
        orgtype:laboratory .

orgtype:university a skos:Concept , ac:OrganizationType ;
    skos:inScheme vocab:organization-types ;
    skos:topConceptOf vocab:organization-types ;
    skos:prefLabel "Università"@it , "University"@en ;
    skos:definition "Institution of higher education and research that awards academic degrees."@en ;
    skos:closeMatch vivo:University ;
    skos:note "ROR organization type: education"@en .

orgtype:researchOrganization a skos:Concept , ac:OrganizationType ;
    skos:inScheme vocab:organization-types ;
    skos:topConceptOf vocab:organization-types ;
    skos:prefLabel "Ente di ricerca"@it , "Research organization"@en ;
    skos:definition "Organization whose main mission is research, e.g. a public research organization such as CNR."@en ;
    skos:closeMatch vivo:ResearchOrganization .

orgtype:company a skos:Concept , ac:OrganizationType ;
    skos:inScheme vocab:organization-types ;
    skos:topConceptOf vocab:organization-types ;
    skos:prefLabel "Impresa"@it , "Company"@en ;
    skos:definition "Business organization, e.g. a company with a research and development unit."@en ;
    skos:closeMatch vivo:Company ;
    skos:note "ROR organization type: company"@en .

orgtype:foundation a skos:Concept , ac:OrganizationType ;
    skos:inScheme vocab:organization-types ;
    skos:topConceptOf vocab:organization-types ;
    skos:prefLabel "Fondazione"@it , "Foundation"@en ;
    skos:definition "Non-profit foundation, e.g. one that carries out or funds research."@en ;
    skos:closeMatch vivo:Foundation ;
    skos:note "ROR organization type: nonprofit"@en .

orgtype:consortium a skos:Concept , ac:OrganizationType ;
    skos:inScheme vocab:organization-types ;
    skos:topConceptOf vocab:organization-types ;
    skos:prefLabel "Consorzio"@it , "Consortium"@en ;
    skos:definition "Organization formed by other organizations to work together, e.g. an inter-university consortium such as CINI."@en ;
    skos:closeMatch vivo:Consortium .

orgtype:association a skos:Concept , ac:OrganizationType ;
    skos:inScheme vocab:organization-types ;
    skos:topConceptOf vocab:organization-types ;
    skos:prefLabel "Associazione"@it , "Association"@en ;
    skos:definition "Non-profit association of persons or organizations, e.g. a scientific society such as GRIN."@en ;
    skos:closeMatch vivo:Association ;
    skos:note "ROR organization type: nonprofit"@en .

orgtype:school a skos:Concept , ac:OrganizationType ;
    skos:inScheme vocab:organization-types ;
    skos:topConceptOf vocab:organization-types ;
    skos:prefLabel "Scuola"@it , "School"@en ;
    skos:definition "Unit of a university that coordinates teaching across departments (scuola, formerly facoltà)."@en .

orgtype:department a skos:Concept , ac:OrganizationType ;
    skos:inScheme vocab:organization-types ;
    skos:topConceptOf vocab:organization-types ;
    skos:prefLabel "Dipartimento"@it , "Department"@en ;
    skos:definition "Unit of an organization that carries out research and, in universities, teaching."@en ;
    skos:narrower orgtype:universityDepartment , orgtype:researchOrganizationDepartment ;
    skos:closeMatch vivo:Department .

orgtype:universityDepartment a skos:Concept , ac:OrganizationType ;
    skos:inScheme vocab:organization-types ;
    skos:prefLabel "Dipartimento universitario"@it , "University department"@en ;
    skos:definition "Department of a university."@en ;
    skos:broader orgtype:department ;
    skos:closeMatch vivo:AcademicDepartment .

orgtype:researchOrganizationDepartment a skos:Concept , ac:OrganizationType ;
    skos:inScheme vocab:organization-types ;
    skos:prefLabel "Dipartimento di un ente di ricerca"@it , "Research organization department"@en ;
    skos:definition "Department of a research organization, e.g. a CNR department that coordinates institutes in a scientific area."@en ;
    skos:broader orgtype:department .

orgtype:institute a skos:Concept , ac:OrganizationType ;
    skos:inScheme vocab:organization-types ;
    skos:topConceptOf vocab:organization-types ;
    skos:prefLabel "Istituto"@it , "Institute"@en ;
    skos:definition "Research unit of an organization, e.g. an institute of CNR such as ISTC-CNR."@en ;
    skos:closeMatch vivo:Institute .

orgtype:interdepartmentalCentre a skos:Concept , ac:OrganizationType ;
    skos:inScheme vocab:organization-types ;
    skos:topConceptOf vocab:organization-types ;
    skos:prefLabel "Centro interdipartimentale"@it , "Interdepartmental centre"@en ;
    skos:definition "Unit of a university formed by several departments on a common research or service topic."@en ;
    skos:closeMatch vivo:Center .

orgtype:researchGroup a skos:Concept , ac:OrganizationType ;
    skos:inScheme vocab:organization-types ;
    skos:topConceptOf vocab:organization-types ;
    skos:prefLabel "Gruppo di ricerca"@it , "Research group"@en ;
    skos:definition "Group of people who carry out research together within an organization."@en .

orgtype:laboratory a skos:Concept , ac:OrganizationType ;
    skos:inScheme vocab:organization-types ;
    skos:topConceptOf vocab:organization-types ;
    skos:prefLabel "Laboratorio"@it , "Laboratory"@en ;
    skos:definition "Unit with facilities for research or experimental work."@en ;
    skos:closeMatch vivo:Laboratory .

#################################################################
#    Italian university types (MUR Cercauniversità)
#################################################################

vocab:it-university-types a skos:ConceptScheme ;
    skos:prefLabel "Tipologie di ateneo (Italia)"@it , "Italian university types"@en ;
    dct:creator agent:mur ;
    dct:source <https://cercauniversita.mur.gov.it> ;
    dc:description "Types of Italian universities in the classification of the MUR Cercauniversità service. Every concept is a narrower match of orgtype:university (skos:broadMatch). The Cercauniversità strings are kept as skos:hiddenLabel."@en ;
    skos:hasTopConcept uni-type-it:stateUniversity ,
        uni-type-it:nonStateUniversity ,
        uni-type-it:telematicUniversity ,
        uni-type-it:foreignersUniversity ,
        uni-type-it:excellenceInstitute ,
        uni-type-it:superiorSchool ,
        uni-type-it:advancedDoctoralInstitute .

uni-type-it:stateUniversity a skos:Concept , ac:OrganizationType ;
    skos:inScheme vocab:it-university-types ;
    skos:topConceptOf vocab:it-university-types ;
    skos:prefLabel "Ateneo statale"@it , "State university"@en ;
    skos:hiddenLabel "Ateneo Statale"@it ;
    skos:definition "State university."@en ;
    skos:broadMatch orgtype:university .

uni-type-it:nonStateUniversity a skos:Concept , ac:OrganizationType ;
    skos:inScheme vocab:it-university-types ;
    skos:topConceptOf vocab:it-university-types ;
    skos:prefLabel "Ateneo non statale"@it , "Non-state university"@en ;
    skos:hiddenLabel "Ateneo Non Statale"@it ;
    skos:definition "Non-state university legally recognized by the State (università non statale legalmente riconosciuta)."@en ;
    skos:broadMatch orgtype:university .

uni-type-it:telematicUniversity a skos:Concept , ac:OrganizationType ;
    skos:inScheme vocab:it-university-types ;
    skos:topConceptOf vocab:it-university-types ;
    skos:prefLabel "Ateneo telematico"@it , "Online university"@en ;
    skos:hiddenLabel "Ateneo Telematico"@it ;
    skos:definition "Non-state university that delivers its courses online (università telematica)."@en ;
    skos:broadMatch orgtype:university .

uni-type-it:foreignersUniversity a skos:Concept , ac:OrganizationType ;
    skos:inScheme vocab:it-university-types ;
    skos:topConceptOf vocab:it-university-types ;
    skos:prefLabel "Università per stranieri"@it , "University for foreigners"@en ;
    skos:hiddenLabel "Università per Stranieri"@it ;
    skos:definition "University devoted in particular to the teaching and spread of Italian language and culture to foreign students."@en ;
    skos:broadMatch orgtype:university .

uni-type-it:excellenceInstitute a skos:Concept , ac:OrganizationType ;
    skos:inScheme vocab:it-university-types ;
    skos:topConceptOf vocab:it-university-types ;
    skos:prefLabel "Istituto speciale"@it , "Special institute"@en ;
    skos:hiddenLabel "Istituto Speciale"@it ;
    skos:editorialNote "Category of the Cercauniversità classification; definition and list of the institutions to be documented from the MUR sources."@en ;
    skos:broadMatch orgtype:university .

uni-type-it:superiorSchool a skos:Concept , ac:OrganizationType ;
    skos:inScheme vocab:it-university-types ;
    skos:topConceptOf vocab:it-university-types ;
    skos:prefLabel "Scuola superiore"@it , "Superior school"@en ;
    skos:hiddenLabel "Scuola Superiore"@it ;
    skos:editorialNote "Category of the Cercauniversità classification; definition and list of the institutions to be documented from the MUR sources."@en ;
    skos:broadMatch orgtype:university .

uni-type-it:advancedDoctoralInstitute a skos:Concept , ac:OrganizationType ;
    skos:inScheme vocab:it-university-types ;
    skos:topConceptOf vocab:it-university-types ;
    skos:prefLabel "Istituto di alta formazione dottorale"@it , "Advanced doctoral institute"@en ;
    skos:hiddenLabel "Istituto di Alta Formazione Dottorale"@it ;
    skos:editorialNote "Category of the Cercauniversità classification; definition and list of the institutions to be documented from the MUR sources."@en ;
    skos:broadMatch orgtype:university .
