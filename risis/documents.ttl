@prefix : <https://w3id.org/fossr/onto/documents/> .
@prefix doc: <https://w3id.org/fossr/onto/documents/> .
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/fossr/onto/documents/> .

<https://w3id.org/fossr/onto/documents> rdf:type owl:Ontology ;
    rdfs:label "FOSSR Documents module"@en ;
    rdfs:comment "Entity-level module for documents (publications, project deliverables, reports, administrative documents such as minutes), independent of the data sources they are described in. Source records (e.g. Scopus or Web of Science records) are modelled in the publications module and linked to documents through pub:describes."@en .

#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationObject
dul:InformationObject rdf:type owl:Class .


###  https://w3id.org/fossr/onto/documents/Document
:Document rdf:type owl:Class ;
          rdfs:subClassOf dul:InformationObject ;
          rdfs:label "Document"@en ;
          rdfs:comment "A real-world document, considered independently of any data source describing it: e.g. a scholarly publication, a project deliverable, a report, an administrative document such as the minutes of a meeting."@en .
